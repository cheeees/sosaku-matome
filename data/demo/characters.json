       },
       {
        "t": "高校入学 ― 図書委員になる",
        "d": "誰よりも早く登校して、人のいない図書室で本の整理をするのが日課になる。"
       },
       {
        "t": "今 ― ひそかに物語を書いている",
        "d": "誰にも見せたことのない物語がある。いつか図書室の棚に並べたい。"
       }
      ]
     }

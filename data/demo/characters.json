     "v": {
      "i1": "高校一年生・図書委員",
      "i2": "口数が少なく慎重。誤解されやすいが、人の変化によく気がつく。決めたことは粘り強くやり抜く",
      "i4": "祖父から革の栞をもらった。栞は今も、どの本にも挟んでいる",
      "i3": "読書、傷んだ本の修繕",
      "i5": "雨の日の図書室、古い文庫本の匂い、温かいミルクティー",
      "i6": "準備なしで知らない場所へ行くこと、急な変化",
      "i9": "急かさずに待ってくれる人",
      "i10": "いきなり距離を詰めてくる人",
      "i11": "気づかれないように、さりげなく世話を焼く",
      "i12": "本の話を、急かさずに最後まで聞いてくれる",
      "i13": "本を雑に扱われる",
      "i14": "雨の日の図書室にいる、慎重で粘り強い本の虫"
     }
    },
